<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.gettuh.AIOstreamer</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <name>AIOstreamer</name>
  <summary>Fast 10-foot AIOStreams client with mpv playback</summary>
  <description>
    <p>A TV-first client for your AIOStreams configuration, driven entirely by a remote, gamepad or keyboard.
    Playback is handed to a fullscreen mpv so HDR output is preserved.</p>
    <ul>
      <li>Continue Watching, Next Up, My List and a row for every AIOStreams catalog</li>
      <li>Shows with seasons and Specials, search, catalog browsing with genres</li>
      <li>Versions in your AIOStreams sort order with resolution, HDR, audio, size and debrid cache status</li>
      <li>Resume, Up Next and version switching inside mpv</li>
      <li>Subtitles from your subtitle addons, audio passthrough, skip intro by chapters</li>
      <li>Several AIOStreams configurations, cached catalogs and metadata</li>
    </ul>
  </description>
  <launchable type="desktop-id">io.github.gettuh.AIOstreamer.desktop</launchable>
