<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.gettuh.JellyfinTV</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <name>Jellyfin TV</name>
  <summary>Fast 10-foot Jellyfin client with mpv playback</summary>
  <description>
    <p>A TV-first frontend for Jellyfin-compatible servers such as Remux, driven entirely by a remote or keyboard.
    Playback is handed to a fullscreen mpv so HDR output is preserved.</p>
    <ul>
      <li>Continue Watching, Next Up, favorites and library rows</li>
      <li>Shows with seasons and Specials, search, version picker</li>
      <li>Resume, progress reporting and Up Next inside mpv</li>
      <li>Original audio language, bitrate cap for the default version</li>
      <li>Quick Connect login and multiple accounts</li>
      <li>Remote control from Jellyfin apps and SyncPlay</li>
      <li>Skip intro, seek preview thumbnails, audio passthrough</li>
    </ul>
  </description>
  <launchable type="desktop-id">io.github.gettuh.JellyfinTV.desktop</launchable>
  <url type="homepage">https://github.com/GetTuh/jellyfin-tv-linux</url>
